# Flanker Bar · caché y cabeceras (Hostinger / Apache)

# No publicar archivos de trabajo
RedirectMatch 404 ^/(CLAUDE|README|BRIEF)\.md$
RedirectMatch 404 ^/\.(claude|git)(/|$)
RedirectMatch 404 ^/\.gitignore$

<IfModule mod_headers.c>
  # HTML y datos editables: siempre frescos tras cada publicación
  <FilesMatch "\.(html|htm|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # CSS y JS sin hash en el nombre: 1 día y revalidar
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  # Imágenes, vídeo y fuentes: 1 mes
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Forzar HTTPS (activar cuando el dominio tenga SSL)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
